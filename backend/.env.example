# =====================================================
# GreenWear 백엔드 환경 변수
# 이 파일을 복사해서 .env 파일로 저장하고 값을 채우세요
# .env 파일은 절대 git에 올리지 마세요!
# =====================================================

# 서버
PORT=5000
NODE_ENV=production

# ── MariaDB 연결 정보 ──────────────────────────────
# Railway MySQL 플러그인 사용 시 → Railway 대시보드에서 자동 제공
DB_HOST=localhost
DB_PORT=3306
DB_USER=greenwear_user
DB_PASSWORD=greenwear_password
DB_NAME=greenwear_db
# SSL이 필요한 서비스(Aiven 등) 사용 시 TRUE
DB_SSL=false

# ── CORS 허용 도메인 ───────────────────────────────
# 쉼표로 구분, 프론트 Vercel 주소를 여기에 넣으세요
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ── 로그 레벨 ──────────────────────────────────────
LOG_LEVEL=INFO
